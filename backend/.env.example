# 複製成 .env 後再修改。【重要】.env 不得 commit 進 git。
SHOP_ENV=development
SHOP_DATABASE_URL=sqlite:///./shop.db
# 前端網址白名單（JSON 陣列格式）
SHOP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SHOP_SESSION_DAYS=7
# 金流簽章金鑰：正式環境一定要換成長且隨機的字串（例如 python -c "import secrets;print(secrets.token_urlsafe(48))"）
SHOP_PAYMENT_WEBHOOK_SECRET=dev-only-change-me
# 示範帳號密碼（只在執行 scripts/seed.py 時使用）
SHOP_SEED_ADMIN_PASSWORD=admin12345
SHOP_SEED_DEMO_PASSWORD=demo12345
